{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chong",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-16",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/my-photography-profile/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only /api/* runs the Worker; everything else is served straight from assets.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chong-db",
      "database_id": "f7e80cbc-6c7c-4c60-80fa-922f5af51754",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}

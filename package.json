{
  "name": "my-photography-profile",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "vercel-build": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.js",
    "preview": "ng build && wrangler dev",
    "deploy": "ng build && tsc -p worker/tsconfig.json && wrangler deploy",
    "dev:api": "wrangler dev --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply chong-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply chong-db --remote",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "photos:build": "node scripts/photos/process.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.7",
    "@angular/cdk": "^22.1.7",
    "@angular/cdk-experimental": "^22.1.7",
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "@angular/material": "^22.1.7",
    "@angular/material-experimental": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@angular/platform-browser-dynamic": "^22.1.7",
    "@angular/router": "^22.1.7",
    "@fancyapps/ui": "^5.0.36",
    "@phosphor-icons/core": "^2.1.1",
    "@tailwindcss/postcss": "^4.2.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.7",
    "@types/jest": "^30.0.0",
    "exif-reader": "^2.0.3",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-preset-angular": "^17.0.0",
    "jsdom": "^29.0.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.3",
    "wrangler": "^4.132.0"
  }
}
